DATABASE_URL=postgresql://user:password@ep-example-holy-butterfly.aws.neon.tech/neondb?sslmode=require&channel_binding=require #usually we use neon DB but on scaling we might switch to our own postgres

# Auth — generate with: openssl rand -base64 32
SESSION_SECRET=changeme-generate-a-real-32-byte-base64-secret

# Public package catalogue (/packages) — number customers are sent to on
# "Enquire". Any WhatsApp-capable number with country code; the buttons are
# hidden when this is unset.
NEXT_PUBLIC_ENQUIRY_WHATSAPP=919847000000

# File uploads (cover images, itinerary photos, expense bills)
#
# Files are written to <UPLOADS_BASE_DIR>/<UPLOADS_PROJECT_NAME>/<folder>/<uuid>.<ext>
# and served at /uploads/<folder>/<uuid>.<ext>.
#
# UPLOADS_PROJECT_NAME is what keeps apps sharing this VPS apart — give every
# app on the box its own name and their files never mix. Filenames are random
# UUIDs on top of that, so nothing overwrites anything even by accident.
#
# On Windows leave UPLOADS_BASE_DIR pointing somewhere writable, e.g. D:/uploads
UPLOADS_BASE_DIR=/var/www/uploads
UPLOADS_PROJECT_NAME=admin-next-starter
# Leave empty to serve uploads from this app's own origin (the normal setup —
# each app has its own domain). Only set it if uploads live on another host.
NEXT_PUBLIC_UPLOADS_BASE_URL=
#
# In production let Nginx serve the files directly instead of Node — add this to
# THIS app's server block only, so the two apps never read each other's dirs:
#
#   client_max_body_size 12M;                       # above MAX_UPLOAD_BYTES
#   location /uploads/ {
#     alias /var/www/uploads/admin-next-starter/;   # trailing slash matters
#     access_log off;
#     expires max;
#     add_header Cache-Control "public, immutable";
#     add_header X-Content-Type-Options "nosniff";
#     try_files $uri =404;
#   }
#
# The app also serves /uploads itself, so this is an optimisation, not a
# requirement. Make sure the Node process owns (or can write to) the directory.

# Seed script — set before running npm run db:seed
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_EMAIL=